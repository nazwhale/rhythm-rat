{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rhythm-rat",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-15",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "rhythm-rat", "database_id": "150598ab-11e2-4f70-a382-6434fc82fa7f", "migrations_dir": "migrations" }],
  "services": [{ "binding": "EMAIL", "service": "worker-email" }],
  "observability": { "enabled": true },
  "env": {
    "preview": {
      "name": "rhythm-rat-preview",
      "d1_databases": [{ "binding": "DB", "database_name": "rhythm-rat-preview", "database_id": "0c7ca199-1cd4-4530-9844-db0b19ce3806", "migrations_dir": "migrations" }],
      "services": [{ "binding": "EMAIL", "service": "worker-email" }]
    }
  }
}
